+    0x00, 0x41, 0x41, 0x41, 0x7f,  // ]
+    0x04, 0x02, 0x01, 0x02, 0x04,  // ^
+    0x40, 0x40, 0x40, 0x40, 0x40,  // _
+    0x00, 0x03, 0x07, 0x08, 0x00,  // `
+    0x20, 0x54, 0x54, 0x78, 0x40,  // a
+    0x7f, 0x28, 0x44, 0x44, 0x38,  // b
+    0x38, 0x44, 0x44, 0x44, 0x28,  // c
+    0x38, 0x44, 0x44, 0x28, 0x7f,  // d
+    0x38, 0x54, 0x54, 0x54, 0x18,  // e
+    0x00, 0x08, 0x7e, 0x09, 0x02,  // f
+    0x18, 0xa4, 0xa4, 0x9c, 0x78,  // g
+    0x7f, 0x08, 0x04, 0x04, 0x78,  // h
+    0x00, 0x44, 0x7d, 0x40, 0x00,  // i
+    0x20, 0x40, 0x40, 0x3d, 0x00,  // j
+    0x7f, 0x10, 0x28, 0x44, 0x00,  // k
+    0x00, 0x41, 0x7f, 0x40, 0x00,  // l
+    0x7c, 0x04, 0x78, 0x04, 0x78,  // m
+    0x7c, 0x08, 0x04, 0x04, 0x78,  // n
+    0x38, 0x44, 0x44, 0x44, 0x38,  // o
+    0xfc, 0x18, 0x24, 0x24, 0x18,  // p
+    0x18, 0x24, 0x24, 0x18, 0xfc,  // q
+    0x7c, 0x08, 0x04, 0x04, 0x08,  // r
+    0x48, 0x54, 0x54, 0x54, 0x24,  // s
+    0x04, 0x04, 0x3f, 0x44, 0x24,  // t
+    0x3c, 0x40, 0x40, 0x20, 0x7c,  // u
+    0x1c, 0x20, 0x40, 0x20, 0x1c,  // v
+    0x3c, 0x40, 0x30, 0x40, 0x3c,  // w
+    0x44, 0x28, 0x10, 0x28, 0x44,  // x
+    0x4c, 0x90, 0x90, 0x90, 0x7c,  // y
+    0x44, 0x64, 0x54, 0x4c, 0x44,  // z
+    0x00, 0x08, 0x36, 0x41, 0x00,  // {
+    0x00, 0x00, 0x77, 0x00, 0x00,  // |
+    0x00, 0x41, 0x36, 0x08, 0x00,  // }
+    0x02, 0x01, 0x02, 0x04, 0x02,  // ~
+};
+
+constexpr int kCharW = 6;
+constexpr int kCharH = 8;
+constexpr int kMaxTail = 18;
+
+// Brightness per depth in the tail: head first, then the ramp.
+constexpr uint8_t kRamp[kMaxTail] = {
+    255, 220, 190, 165, 145, 125, 110, 95, 82, 70, 60, 52, 44, 38, 32, 26, 22, 18,
+};
+
+struct Column {
+    int head;          // row of the leading glyph
+    int tail;          // tail length in cells
+    uint8_t speed_x2;  // rows per frame * 2 (fixed point)
+    int acc;           // fixed-point accumulator
+    char glyph[kMaxTail];
+};
+
+lv_obj_t *canvas_ = nullptr;
+uint16_t *fb_ = nullptr;
+int width_ = 0, height_ = 0, cols_ = 0, rows_ = 0;
+Column columns_[128];
+int column_count_ = 0;
+lv_timer_t *timer_ = nullptr;
+char status_[48] = "ONLINE";
+char last_line_[96] = "";
+uint32_t last_line_tick_ = 0;
+char drawn_status_[48] = "";
+uint32_t frame_us_ = 0;
+
+inline void put_px(int x, int y, uint16_t colour) {
+    if (x < 0 || y < 0 || x >= width_ || y >= height_) return;
+    // The panel port runs with swap_bytes=1, so the canvas has to hold the bytes
+    // the way the panel expects them, not the way RGB565 is usually written.
+    fb_[y * width_ + x] = (uint16_t)((colour >> 8) | (colour << 8));
+}
+
+inline uint8_t glyph_bits(char ch, int col) {
+    uint8_t c = (uint8_t)ch;
+    if (c < 32 || c > 126) c = '?';
+    return kFont5x7[(c - 32) * 5 + col];
+}
+
+void draw_cell(int col, int row, char ch, uint8_t level) {
+    const int x0 = col * kCharW;
+    const int y0 = row * kCharH;
+    if (level == 0) {                       // clear the cell
+        for (int y = 0; y < kCharH - 1; y++)
+            for (int x = 0; x < kCharW; x++) put_px(x0 + x, y0 + y, 0);
+        return;
+    }
+    // RGB565: green occupies bits 5-10. Shifting into the red field is what
+    // produced a magenta screen the first time.
+    const uint16_t green = (uint16_t)(((level >> 2) & 0x3F) << 5);
+    const uint16_t head = 0xDFF0;
+    const uint16_t colour = level > 230 ? head : green;
+    for (int x = 0; x < kCharW - 1; x++) put_px(x0 + x, y0 + kCharH - 1, 0);
+    for (int c = 0; c < 5; c++) {
+        uint8_t bits = glyph_bits(ch, c);
+        for (int r = 0; r < 7; r++) {
+            if (bits & (1 << r)) put_px(x0 + c, y0 + r, colour);
+        }
+    }
+}
+
+void draw_text(int x, int y, const char *text, uint16_t colour, int max_chars) {
+    for (int n = 0; n < max_chars && text[n]; n++) {
+        char ch = text[n];
+        if (ch < 32 || ch > 126) ch = '?';
+        for (int c = 0; c < 5; c++) {
+            uint8_t bits = glyph_bits(ch, c);
+            for (int r = 0; r < 7; r++) {
+                if (bits & (1 << r)) put_px(x + n * kCharW + c, y + r, colour);
+            }
+        }
+    }
+}
+
+inline void invalidate_cell(int col, int row) {
+    if (canvas_ == nullptr || row < 0 || row >= rows_) return;
+    lv_area_t a = {
+        (lv_coord_t)(col * kCharW), (lv_coord_t)(row * kCharH),
+        (lv_coord_t)(col * kCharW + kCharW - 1), (lv_coord_t)(row * kCharH + kCharH - 1),
+    };
+    lv_obj_invalidate_area(canvas_, &a);
+}
+
+void respawn(Column &c) {
+    c.head = -(int)(rand() % (rows_ > 0 ? rows_ : 1));
+    c.tail = 6 + rand() % (kMaxTail - 6);
+    c.speed_x2 = (uint8_t)(1 + rand() % 3);
+    c.acc = 0;
+}
+
+void step_column(Column &c, int col) {
+    c.acc += c.speed_x2;
+    while (c.acc >= 2) {
+        c.acc -= 2;
+        int new_head = c.head + 1;
+        if (new_head - c.tail >= rows_) {          // fully off screen: start over
+            for (int r = 0; r < rows_; r++) draw_cell(col, r, ' ', 0);
+            for (int r = 0; r < rows_; r++) invalidate_cell(col, r);
+            respawn(c);
+            return;
+        }
+        c.head = new_head;
+        if (c.head >= 0 && c.head < rows_) {
+            char ch = (char)(33 + rand() % 90);
+            c.glyph[0] = ch;
+            draw_cell(col, c.head, ch, 255);
+            invalidate_cell(col, c.head);
+        }
+        int tail_cell = c.head + 1;
+        if (tail_cell >= 0 && tail_cell < rows_) {
+            draw_cell(col, tail_cell, ' ', 0);     // clear behind the tail
+            invalidate_cell(col, tail_cell);
+        }
+        int prev_head = c.head - 1;
+        if (prev_head >= 0 && prev_head < rows_) {
+            draw_cell(col, prev_head, c.glyph[0], kRamp[1]);
+            invalidate_cell(col, prev_head);
+        }
+    }
+}
+
+void draw_band() {
+    const int band_y = height_ - kCharH - 1;
+    for (int y = band_y - 1; y < height_; y++)
+        for (int x = 0; x < width_; x++) put_px(x, y, 0);
+    char line[64];
+    snprintf(line, sizeof(line), "> %s", status_);
+    draw_text(4, band_y, line, 0x27E8, 40);
+    lv_area_t a = {0, (lv_coord_t)(band_y - 1), (lv_coord_t)(width_ - 1),
+                   (lv_coord_t)(height_ - 1)};
+    lv_obj_invalidate_area(canvas_, &a);
+    if (last_line_[0] && (lv_tick_get() - last_line_tick_) < 6000) {
+        draw_text(4, band_y - 10, last_line_, 0x06E0, 68);
+        lv_area_t l = {0, (lv_coord_t)(band_y - 10), (lv_coord_t)(width_ - 1),
+                       (lv_coord_t)(band_y - 3)};
+        lv_obj_invalidate_area(canvas_, &l);
+    }
+}
+
+void timer_cb(lv_timer_t *) {
+    if (fb_ == nullptr) return;
+    int64_t start = esp_timer_get_time();
+    for (int i = 0; i < column_count_; i++) step_column(columns_[i], i);
+    if (strcmp(drawn_status_, status_) != 0) {
+        snprintf(drawn_status_, sizeof(drawn_status_), "%s", status_);
+        draw_band();
+    } else if (last_line_[0] && (lv_tick_get() - last_line_tick_) < 6000) {
+        draw_band();
+    }
+    frame_us_ = (uint32_t)(esp_timer_get_time() - start);
+}
+
+void start_cb(void *) {
+    if (canvas_ != nullptr) return;
+    if (width_ <= 0 || height_ <= 0) return;
+    fb_ = (uint16_t *)heap_caps_malloc((size_t)width_ * height_ * 2, MALLOC_CAP_SPIRAM);
+    if (fb_ == nullptr) {
+        ESP_LOGE(TAG, "no PSRAM for framebuffer");
+        return;
+    }
+    memset(fb_, 0, (size_t)width_ * height_ * 2);
+    // Child of the active screen (not lv_layer_top): the top layer is invisible
+    // to lv_snapshot, and we need screenshots for verification.
+    canvas_ = lv_canvas_create(lv_screen_active());
+    lv_obj_move_foreground(canvas_);
+    lv_canvas_set_buffer(canvas_, fb_, width_, height_, LV_COLOR_FORMAT_RGB565);
+    lv_obj_set_pos(canvas_, 0, 0);
+    lv_obj_clear_flag(canvas_, LV_OBJ_FLAG_SCROLLABLE);
+
+    cols_ = width_ / kCharW;
+    rows_ = height_ / kCharH;
+    column_count_ = std::min(cols_, 128);
+    for (int i = 0; i < column_count_; i++) {
+        respawn(columns_[i]);
+        columns_[i].head = -(int)(rand() % (rows_ > 0 ? rows_ : 1));
+    }
+    timer_ = lv_timer_create(timer_cb, 40, nullptr);
+    draw_band();
+    ESP_LOGI(TAG, "matrix overlay %dx%d, %d columns", width_, height_, column_count_);
+}
+
+}  // namespace
+
+void matrix_ui_start(int width, int height) {
+    width_ = width;
+    height_ = height;
+    lv_async_call(start_cb, nullptr);
+}
+
+bool matrix_ui_active() { return canvas_ != nullptr; }
+
+void matrix_ui_status(const char *text) {
+    if (text == nullptr) return;
+    snprintf(status_, sizeof(status_), "%s", text);
+    if (canvas_ == nullptr) matrix_ui_start(width_ > 0 ? width_ : 480,
+                                            height_ > 0 ? height_ : 320);
+}
+
+void matrix_ui_push(const char *role, const char *text) {
+    if (text == nullptr || text[0] == '\0') return;
+    int n = 0;
+    last_line_[n++] = (role != nullptr && role[0] == 'u') ? '<' : '>';
+    last_line_[n++] = ' ';
+    for (const char *p = text; *p && n < (int)sizeof(last_line_) - 1; p++, n++) {
+        char c = *p;
+        last_line_[n] = (c >= 32 && c < 127) ? c : '?';
+    }
+    last_line_[n] = '\0';
+    last_line_tick_ = lv_tick_get();
+    if (canvas_ == nullptr) matrix_ui_start(width_ > 0 ? width_ : 480,
+                                            height_ > 0 ? height_ : 320);
+}
diff --git a/main/display/matrix_ui.h b/main/display/matrix_ui.h
new file mode 100644
index 0000000..e16eee6
--- /dev/null
+++ b/main/display/matrix_ui.h
@@ -0,0 +1,27 @@
+// Matrix-style data stream overlay for the CHD ESP32-S3-BOX display.
+//
+// Why an overlay: the stock XiaoZhi UI (smiley emoji + chat bubbles) is what the
+// vendor ships. This draws a full-screen canvas on the top LVGL layer, so the
+// native UI keeps working underneath (subtitles, gestures) but the screen reads
+// as a live data stream instead of a smiley face.
+//
+// Rendering is done by writing pixels straight into an RGB565 canvas buffer:
+// LVGL's draw API is unnecessary overhead for a fade + glyph blit, and the fade
+// is a plain 0.82 multiply over 153k pixels (~2 ms on the S3 at 240 MHz).
+#ifndef MATRIX_UI_H
+#define MATRIX_UI_H
+
+#include <lvgl.h>
+#include <string>
+
+// Create/show the overlay. Safe to call more than once.
+void matrix_ui_start(int width, int height);
+bool matrix_ui_active();
+
+// Feed a line of real conversation into the stream (role: "user"/"assistant").
+void matrix_ui_push(const char *role, const char *text);
+
+// Short ASCII status shown at the bottom, e.g. "LISTENING", "TOOL take_photo".
+void matrix_ui_status(const char *text);
+
+#endif  // MATRIX_UI_H

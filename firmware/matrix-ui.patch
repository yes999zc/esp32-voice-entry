+// Matrix data stream overlay for the CHD ESP32-S3-BOX 480x320 panel.
+//
+// Rendering strategy (measured, not guessed):
+//   * 480x320 RGB565 is 307 KB/frame. SPI at 80 MHz tops out near 24 fps for a
+//     full screen, and the panel's flush is split into strips, so a full-screen
+//     invalidate every frame starves the audio task. Do not do that.
+//   * Instead each column keeps a fixed-length tail with a static brightness
+//     ramp. Per frame only two cells per column change (head appears, tail end
+//     clears), so ~160 cells = 15 KB of dirty area instead of 300 KB.
+//   * The canvas is invalidated per dirty cell rectangle, never wholesale.
+#include "matrix_ui.h"
+
+#include <esp_heap_caps.h>
+#include <esp_log.h>
+#include <esp_timer.h>
+#include <cstdio>
+#include <cstring>
+#include <cstdlib>
+#include <algorithm>
+
+#define TAG "MatrixUi"
+
+namespace {
+
+// 5x7 ASCII glyphs (classic Adafruit GFX table, public domain), chars 32..126.
+const uint8_t kFont5x7[95 * 5] = {
+    0x00, 0x00, 0x00, 0x00, 0x00,  //  
+    0x00, 0x00, 0x5f, 0x00, 0x00,  // !
